# PM Workspace Automation Environment Variables
#
# Copy this file to .env and fill in your values.
# This file is loaded by lib.sh at runtime.

# Slack webhook for automation alerts (failures + success notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Optional: Per-agent Slack webhooks (for posting to dedicated channels)
# SLACK_WEBHOOK_COS=https://hooks.slack.com/services/YOUR/COS/WEBHOOK
# SLACK_WEBHOOK_ANALYST=https://hooks.slack.com/services/YOUR/ANALYST/WEBHOOK
# SLACK_WEBHOOK_UXR=https://hooks.slack.com/services/YOUR/UXR/WEBHOOK

# Optional: Telegram bot for mobile alerts
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
